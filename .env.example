# Copy to .env before running `docker compose up`. Never commit the real .env.
# Here we use plain env vars for credentials

# --- MinIO (single object store: landing + bronze/silver/gold buckets) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://minio:9000
LANDING_BUCKET=landing
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold

# --- Airflow metadata DB (PostgreSQL) ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me
# JWT secret for Airflow 3 API / task execution (any long random string is fine locally).
AIRFLOW_JWT_SECRET=change-me-jwt-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_UID=50000

# --- Pipeline config ---
# Silver -> Gold rolling window length (anchor day + preceding N-1 days). The
# data-science model uses 7; the window must stay configurable.
ROLLING_WINDOW_DAYS=7
SCHEMA_VERSION=v1

# --- Docker wiring (used by the Airflow DAG to launch task containers) ---
NETWORK_NAME=platform-net
IMG_SIMULATOR=clap-lanl-simulator:dev
IMG_SPARK=clap-spark-processor:dev
# Absolute host path to this project root (bind-mounts data/subset into the
# simulator task container). Typically set to the repo root, e.g. $(pwd).
HOST_PROJECT_DIR=.
# Docker socket GID on the host (so Airflow can launch sibling containers).
# macOS Docker Desktop: 0. Linux: run `stat -c '%g' /var/run/docker.sock`.
DOCKER_GID=0
