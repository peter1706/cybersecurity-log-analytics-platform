# Copy to .env before running `docker compose up'
#
# This file holds NON-SENSITIVE config only. All credentials are file-based
# Docker secrets under ./secrets (mounted at /run/secrets/<name>)

# --- MinIO (single object store: landing + bronze/silver/gold/delivered buckets) ---
MINIO_ENDPOINT=http://minio:9000
LANDING_BUCKET=landing
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold
DELIVERED_BUCKET=delivered

# --- Airflow metadata DB (PostgreSQL) ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow

# --- Governance catalog DB (postgres-catalog) ---
# Host/port default to the compose service name; name/user are plain config. The
# password is the postgres_catalog_password secret.
CATALOG_DB_HOST=postgres-catalog
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_UID=50000

# --- Pipeline config ---
# Silver -> Gold rolling window length (anchor day + preceding N-1 days). The
# defailt data-science model uses 7 but the window can be changed.
ROLLING_WINDOW_DAYS=7
SCHEMA_VERSION=v1

# --- Spark tuning (forwarded into every spark-processor task) ---
# Driver JVM heap for the local Spark jobs. (raise for larger
# days/windows; lower it if your Docker VM has little RAM).
SPARK_DRIVER_MEMORY=3g
# Shuffle partitions. The default (200) is wasteful for this single-node,
# bounded dataset; a small value cuts task-scheduling overhead.
SPARK_SQL_SHUFFLE_PARTITIONS=8
# Executor sizing (memory / cores / count). Under the default local[*] master
# these are inert (driver == executor), but they let the same image scale out on
# a real Spark cluster by changing only these settings.
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1
SPARK_EXECUTOR_INSTANCES=1

# --- Delivery / consumer ---
# Host port for the always-on ml-mock Streamlit dashboard.
ML_DASHBOARD_PORT=8501
# Airflow API base URL as seen from the ml-dashboard container (airflow-net).
AIRFLOW_API_URL=http://airflow-api-server:8080

# --- Docker wiring (used by the Airflow DAG to launch task containers) ---
# Three isolated networks: data plane, orchestration, and consumer.
PIPELINE_NETWORK_NAME=clap-pipeline-net
AIRFLOW_NETWORK_NAME=clap-airflow-net
ML_NETWORK_NAME=clap-ml-net
IMG_AIRFLOW=clap-airflow:dev
IMG_SIMULATOR=clap-lanl-simulator:dev
IMG_SPARK=clap-spark-processor:dev
IMG_DELIVERY=clap-delivery:dev
IMG_ML_MOCK=clap-ml-mock:dev
# The five IMG_* vars above default to local `:dev` tags -- `make build` builds
# every image from the Dockerfiles in this repo, no registry access needed.
#
# .github/workflows/publish-images.yml additionally publishes the same
# Dockerfiles to GHCR (ghcr.io/<owner>/<repo>/<image>) on every push to `main`
# (tag `sha-<short-git-sha>`) and on release tags (tag `vX.Y[.Z][-pre]`, e.g.
# `v0.10-rc.1`), so a specific published build can be pulled and run instead of
# building locally, e.g.:
#   IMG_AIRFLOW=ghcr.io/peter1706/cybersecurity-log-analytics-platform/clap-airflow:sha-abcdef1
#   IMG_SIMULATOR=ghcr.io/peter1706/cybersecurity-log-analytics-platform/clap-lanl-simulator:sha-abcdef1
#   IMG_SPARK=ghcr.io/peter1706/cybersecurity-log-analytics-platform/clap-spark-processor:sha-abcdef1
#   IMG_DELIVERY=ghcr.io/peter1706/cybersecurity-log-analytics-platform/clap-delivery:sha-abcdef1
#   IMG_ML_MOCK=ghcr.io/peter1706/cybersecurity-log-analytics-platform/clap-ml-mock:sha-abcdef1
# With these set, skip `make build`: `docker compose up` pulls the pinned tags
# instead (the GHCR package must be public, or you must `docker login ghcr.io`
# first).

# Absolute host path to this project root (bind-mounts data/subset and the
# ./secrets dir into task containers). Typically set to the repo root, e.g. $(pwd).
HOST_PROJECT_DIR=.
# Docker socket GID on the host (so Airflow can launch sibling containers).
DOCKER_GID=0
